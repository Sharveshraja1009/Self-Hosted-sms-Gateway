{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    /* Production emit: only src, flattened straight into dist/. */
    "rootDir": "src",
    "outDir": "dist",
    "sourceMap": false
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist", "tests", "**/*.test.ts", "**/*.spec.ts"]
}
