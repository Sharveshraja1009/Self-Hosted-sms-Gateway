# ---------------------------------------------------------------------------
# SMS Gateway - Backend environment
# Copy to `.env` and adjust. Every variable here is validated at boot by
# src/config/env.ts - the process refuses to start if anything is missing or
# malformed, so a misconfigured server never reaches production traffic.
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------
APP_NAME=sms-gateway
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
API_PREFIX=/api

# Number of reverse proxies in front of the app (0 = none, 1 = nginx/traefik).
# Required for correct client IPs in rate limiting and audit logs.
TRUST_PROXY=1

# Comma-separated list of allowed browser origins for the dashboard.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Max accepted JSON body size.
BODY_LIMIT=1mb

# How long graceful shutdown waits for in-flight work before forcing exit.
SHUTDOWN_TIMEOUT_MS=15000

# --- Logging ---------------------------------------------------------------
# error | warn | info | http | debug
LOG_LEVEL=debug
LOG_DIR=logs
LOG_TO_FILE=true

# --- Datastores ------------------------------------------------------------
# Matches docker/docker-compose.yml defaults.
#
# directConnection=true: the dev container is a single-node REPLICA SET (not a
# standalone), because transactions and change streams only exist on a replica
# set and Phase 4 will want them. This flag tells the driver to talk to the node
# directly instead of trying to discover a cluster topology that, from outside
# Docker, it cannot resolve.
#
# The dev database has NO AUTHENTICATION - it is bound to localhost and holds
# nothing. In production use a URI WITH credentials and TLS, e.g.
#   mongodb+srv://user:pass@cluster.example.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/?directConnection=true
MONGODB_DB=smsgw
REDIS_URL=redis://localhost:6379

# --- Auth (used from Phase 2 onwards) --------------------------------------
# Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=change_me_dev_access_secret_at_least_32_chars
JWT_REFRESH_SECRET=change_me_dev_refresh_secret_at_least_32_chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
GATEWAY_JWT_TTL=30d
BCRYPT_ROUNDS=12

# --- Rate limiting ---------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# --- SMS policy ------------------------------------------------------------
# IANA timezone used for the daily quota reset boundary (midnight local time).
TIMEZONE=Asia/Kolkata
DEFAULT_DAILY_SMS_LIMIT=100
MESSAGE_MAX_ATTEMPTS=3

# SMS PARTS one SIM may send per local day before the dispatcher refuses to use
# it. This is what stops a carrier blacklisting your numbers - Indian consumer
# SIMs are capped around 100/day. Raise only if you know your carrier allows more.
SIM_DAILY_SMS_LIMIT=100

# --- Campaigns (bulk / promotional sending) --------------------------------
# Default seconds between one send and the next when a campaign does not set its
# own pace. Slow on purpose: back-to-back texts to strangers from a personal SIM
# are the signature a carrier's spam filter blocks for.
CAMPAIGN_DEFAULT_INTERVAL_MS=10000
# The floor under any pace an operator can choose. The safety rail - no campaign
# may send faster than this, whatever interval it asks for.
CAMPAIGN_MIN_INTERVAL_MS=3000
# Hard cap on how many numbers one campaign may target.
CAMPAIGN_MAX_RECIPIENTS=5000
# Dialling code prefixed to bare local numbers a campaign pastes in. A number
# already in +CC form is never touched. India by default.
CAMPAIGN_DEFAULT_COUNTRY_CODE=+91
# Default sending window in whole hours of the server's local day (see TIMEZONE).
# Campaigns only send when the local hour is within [start, end) - business hours
# by default (09:00-18:00), so a promo blast never goes out overnight. Each
# campaign can override these; set start 0 / end 24 to send around the clock.
CAMPAIGN_WINDOW_START_HOUR=9
CAMPAIGN_WINDOW_END_HOUR=18

# --- Gateway (Android device) ----------------------------------------------
# How often the device must ping over WebSocket, and how long we wait before
# declaring it offline.
HEARTBEAT_INTERVAL_MS=30000
GATEWAY_OFFLINE_TIMEOUT_MS=90000

# --- OTP -------------------------------------------------------------------
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=3
