{
  "compilerOptions": {
    /* Node 22 runs modern ES natively - no downleveling needed. */
    "target": "ES2023",
    "lib": ["ES2023"],

    /* True ESM on Node: relative imports must carry the .js extension. */
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    /* No `rootDir` here: this config also type-checks `tests/`, which lives
       outside src. The emit-time rootDir/outDir pair is set in tsconfig.build.json. */
    "outDir": "dist",

    /* Strictness: catch bugs at compile time, not in production. */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": false,
    "forceConsistentCasingInFileNames": true,

    /* Interop + emit */
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "removeComments": false,
    "skipLibCheck": true,
    "isolatedModules": true,

    "types": ["node"]
  },
  "include": ["src/**/*.ts", "tests/**/*.ts", "scripts/**/*.ts", "vitest.config.ts"],
  "exclude": ["node_modules", "dist"]
}
